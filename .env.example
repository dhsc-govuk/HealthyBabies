# Copy this file to .env and fill in the Entra/Blob values before running `docker-compose up -d`.
# See README.md → "Entra ID setup" and "Azure Blob Storage setup" for how to obtain each value.

# --- General ---
APP_PREFIX=family-hubs

# --- PostgreSQL ---
POSTGRES_USER=family_hubs_user
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB_NAME=family_hubs_db

# --- Entra External ID: "familyhubs-adapp-api-mvp" (API) app registration ---
AD_INSTANCE=https://<tenant-name>.ciamlogin.com
AD_TENANT_ID=<tenant-id>
AD_DOMAIN=<tenant-name>.onmicrosoft.com
AD_CLIENT_ID_API=<api-app-application-client-id>
AD_CLIENT_SECRET=<api-app-client-secret-value>

# --- Entra External ID: "familyhubs-adapp-hub-mvp" (SPA/Hub) app registration ---
AD_CLIENT_ID_CLIENT=<hub-app-application-client-id>
AD_AUTHORITY=https://<tenant-name>.ciamlogin.com/
# Format: https://<tenant-name>.onmicrosoft.com/<api-app-application-client-id>/API
AD_SCOPE=https://<tenant-name>.onmicrosoft.com/<api-app-application-client-id>/API

# --- Microsoft Graph (reuses the API app registration's credentials) ---
GRAPH_APPLICATION_OBJECT_ID=<api-app-object-id>
GRAPH_ENTERPRISE_APPLICATION_OBJECT_ID=<api-app-service-principal-object-id>
GRAPH_DEFAULT_USER_PASSWORD=change-me-locally

# --- Default admin user, auto-seeded into the database on API startup ---
DEFAULT_ADMIN_EMAIL=admin@example.onmicrosoft.com
DEFAULT_ADMIN_SUBID=<entra-object-id-of-the-admin-user>

# --- Optional locally: leave blank to skip Blob-backed features (file uploads, bulk-upload
# staging, Data Protection key persistence) — see README "Azure Blob Storage setup" ---
AZURE_BLOB_CONNECTION_STRING=
APPINSIGHTS_CONNECTION_STRING=
